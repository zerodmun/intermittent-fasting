rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    // Helper function to check if the authenticated user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User root document and subcollections
    match /users/{userId} {
      // User can only read and write their own root document
      allow read, write: if isOwner(userId);

      // Devices subcollection: restricted strictly to the user
      match /devices/{deviceId} {
        allow read, write: if isOwner(userId);
      }

      // Notification schedules subcollection: restricted strictly to the user
      match /notificationSchedules/{scheduleId} {
        allow read, write: if isOwner(userId);
      }

      // Fasting records subcollection: restricted strictly to the user
      match /fastingRecords/{recordId} {
        allow read, write: if isOwner(userId);
      }

      // Weight logs subcollection: restricted strictly to the user
      match /weightLogs/{logId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Global default: deny all other collections/documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
